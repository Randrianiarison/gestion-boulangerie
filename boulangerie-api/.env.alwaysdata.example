# Modèle de .env pour l'hébergement gratuit alwaysdata (voir docs/DEPLOIEMENT.md).
# Remplacez COMPTE par le nom de votre compte alwaysdata.

APP_NAME=Boulangerie
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://COMPTE.alwaysdata.net

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Indian/Antananarivo

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Base créée dans Bases de données > MySQL de l'administration alwaysdata.
DB_CONNECTION=mysql
DB_HOST=mysql-COMPTE.alwaysdata.net
DB_PORT=3306
DB_DATABASE=COMPTE_boulangerie
DB_USERNAME=COMPTE
DB_PASSWORD=

# Fichiers plutôt que base de données : moins de connexions sur l'offre gratuite.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Premier compte propriétaire, créé par « php artisan db:seed --force ».
# Supprimez la ligne SEED_OWNER_PIN une fois le seed fait.
SEED_OWNER_NAME="Propriétaire"
SEED_OWNER_PHONE=
SEED_OWNER_PIN=
